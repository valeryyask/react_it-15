# ── Server ────────────────────────────────────────────────
SERVER_PORT=8080

# ── Oracle Database ────────────────────────────────────────
# Copy this file to .env and fill in your real credentials.
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=ORCLPDB1
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
